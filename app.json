{
  "expo": {
    "name": "Saldus",
    "slug": "saldus",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b1f63915-4483-4123-9535-2002dcd600f9"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "saldus",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jean.saldus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#0068E1"
      },
      "package": "com.jean.saldus"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withIosMinDeploymentTarget",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0F1A"
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b1f63915-4483-4123-9535-2002dcd600f9"
      }
    },
    "owner": "fedaykim"
  }
}
