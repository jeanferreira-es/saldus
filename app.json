{
  "expo": {
    "name": "Meu Dinheiro",
    "slug": "meu-dinheiro",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "meudinheiro",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jean.meudinheiro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#4C63F0"
      },
      "package": "com.jean.meudinheiro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withIosMinDeploymentTarget",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0F1A"
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "ecaa60c9-a995-4602-9b33-f2cddce3dca8"
      }
    },
    "owner": "ferracy"
  }
}
